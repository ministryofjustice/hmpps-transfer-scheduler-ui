{%- from "moj/components/interruption-card/macro.njk" import interruptionCard -%}

<form method="post">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}"/>
  {% call interruptionCard({
    heading: "This prisoner has a non-association",
    primaryAction: {
      text: "Continue"
    },
    secondaryAction: {
      text: "Go back",
      href: goBackUrl
    }
  }) -%}
    <p>
      {{ prisonerDetails | firstNameSpaceLastName }} has a non-association at {{ destination.description }} with:
    <ul class="govuk-list govuk-list--bullet">
      {% for person in nonAssociations %}
        <li>{{ person | lastNameCommaFirstName }}</li>
      {% endfor %}
    </ul>
    </p>

    <p>Go back to change the transfer, or continue, taking the non-association into consideration.</p>
  {%- endcall %}
</form>
