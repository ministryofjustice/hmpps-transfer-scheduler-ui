{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "partials/validatedTimeInput/macro.njk" import validatedTimeInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set pageTitle = 'Add transfer details - Plan a transfer' %}

{% block meta %}
  <meta name="autocompleteElements" content="destination"/>
  <meta name="autocompleteElements" content="reason"/>
  <meta name="autocompleteElements" content="logistics"/>
{% endblock %}

{% block innerContent %}
  <span class="govuk-caption-l">Plan a transfer</span>
  <h1 class="govuk-heading-l govuk-!-margin-bottom-6">Enter the details for {{ prisonerDetails | firstNameSpaceLastName}}</h1>

  <form method="post">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    {{ mojDatePicker({
      id: "requestedOn",
      name: "requestedOn",
      label: {
        text: 'When did you receive the transfer request?',
        classes: "govuk-fieldset__legend--m",
        isPageHeading: false
      },
      hint: {
        text: 'For example, 17/5/2024.'
      },
      value: requestedOn,
      errorMessage: validationErrors | findError('requestedOn'),
      classes: 'hmpps-datepicker--fixed-width govuk-body',
      maxDate: inputDate()
    }) }}

    {{ govukSelect({
      id: "reason",
      name: "reason",
      label: { text: "Enter a reason for this transfer", classes: "govuk-label--m", isPageHeading: false },
      hint: { text: "Start typing a reason" },
      items: reasons | fromCodedDescription | addSelectValue('') | setSelectedValue(reason),
      errorMessage: validationErrors | findError('reason')
    }) }}

    {{ govukRadios({
      name: "priority",
      errorMessage: validationErrors | findError('priority'),
      fieldset: {
        legend: {
          text: 'What is the priority of this transfer?',
          isPageHeading: false,
          classes: "govuk-fieldset__legend--m"
        }
      },
      items: priorityOptions | fromCodedDescription | setCheckedValue(priority)
    }) }}

    {{ mojDatePicker({
      id: "startDate",
      name: "startDate",
      label: {
        text: 'What date will ' + prisonerDetails | firstNameSpaceLastName | possessiveComma + ' transfer be? (optional)',
        classes: "govuk-fieldset__legend--m"
      },
      hint: {
        text: 'For example, 17/5/2024.'
      },
      value: startDate,
      errorMessage: validationErrors | findError('startDate'),
      classes: 'hmpps-datepicker--fixed-width govuk-body',
      minDate: inputDate()
    }) }}

    {{ validatedTimeInput({
      id: "startTime",
      name: "startTime",
      classes: 'govuk-!-static-margin-bottom-6',
      fieldset: {
        legend: {
          text: 'What time will ' + prisonerDetails | firstNameSpaceLastName | possessiveComma + ' transfer be? (optional)',
          classes: "govuk-fieldset__legend--m"
        }
      },
      hint: {
        text: 'Use the 24-hour clock. For example, 09 08 or 17 32.'
      },
      validationErrors: validationErrors,
      hour: startTimeHour,
      minute: startTimeMinute
    }) }}

    {{ govukSelect({
      id: "destination",
      name: "destination",
      label: { text: "Enter the prison this prisoner is being transferred to (optional)", classes: "govuk-label--m", isPageHeading: false },
      hint: { text: "Start typing a prison name" },
      items: prisons | fromCodedDescription | addSelectValue('') | setSelectedValue(destination),
      errorMessage: validationErrors | findError('destination')
    }) }}



    {{ govukSelect({
      id: "logistics",
      name: "logistics",
      label: { text: "Which escort type is being used for this transfer? (optional)", classes: "govuk-label--m", isPageHeading: false },
      hint: { text: 'Start typing the escorted transfer type' },
      items: logisticsOptions | fromCodedDescription | addSelectValue('') | setSelectedValue(logistics),
      errorMessage: validationErrors | findError('logistics')
    }) }}

    {{ govukCharacterCount({
      name: "comments",
      errorMessage: validationErrors | findError('comments'),
      maxlength: 225,
      label: {
        text: "Add any comments for this transfer (optional)",
        classes: "govuk-label--m",
        isPageHeading: false
      },
      value: comments
    }) }}

    {{ govukButton({
      text: "Continue",
      preventDoubleClick: true
    }) }}
  </form>
{% endblock %}
