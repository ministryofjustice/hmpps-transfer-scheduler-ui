{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "partials/hiddenInputs/macro.njk" import hiddenInputs %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set fullScreen = true %}
{% set fullWidth = true %}
{% set pageTitle = 'Search for a prisoner - Schedule transfers in bulk' %}

{% if searchTerm %}
  {% set searchResultCount = results.length %}
{% endif %}

{% block innerContent %}
  <div class="govuk-width-container govuk-!-static-margin-bottom-6">
    <span class="govuk-caption-l">Schedule transfers in bulk</span>
    <label for="searchTerm"><h1 class="govuk-heading-l">Search for a prisoner</h1></label>
  </div>

  <div class="block-background govuk-!-padding-top-6 govuk-!-padding-bottom-1 govuk-!-margin-bottom-7">
    <div class="govuk-width-container">
      <search class="moj-search govuk-!-width-two-thirds">
        <form method="POST">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <div class="search-wrapper moj-search__input-wrapper">
            {{ govukInput({
              name: 'searchTerm',
              classes: "moj-search__input",
              hint: {
                text: "Enter name or prison number. A maximum of 10 results can be returned."
              },
              value: searchTerm,
              errorMessage: validationErrors | findError('searchTerm')
            }) }}

            {{ govukButton({
              classes: "search-button",
              text: "Search",
              preventDoubleClick: true
            }) }}
          </div>
        </form>
      </search>
    </div>
  </div>

  <div class="govuk-width-container govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
    {% if not searchTerm %}
      <p class="govuk-!-margin-bottom-6"><strong>Start a search to view prisoner records.</strong></p>
    {% elseif not results.length %}
      <p class="govuk-!-margin-bottom-6"><strong>No prisoner records match your search.</strong></p>
    {% else %}
      {% set rows = [] %}
      {% for prisoner in results %}
        {% set rows = (rows.push([
          {
            html: '<a class="govuk-link govuk-link--no-visited-state" href="' + prisoner.backLink + '">' + prisoner | lastNameCommaFirstName + '</a>'
          },
          {
            text: prisoner.prisonerNumber
          },
          {
            text: prisoner.cellLocation
          },
          {
            classes: 'govuk-link govuk-link--no-visited-state',
            html: '<a class="govuk-link govuk-link--no-visited-state" href="search-prisoners/' + prisoner.prisonerNumber + '">Add to bulk list<span class="govuk-visually-hidden"> (' + prisoner | lastNameCommaFirstName + ')</span></a>'
          }
        ]), rows) %}
      {% endfor %}
      {{ govukTable({
        firstCellIsHeader: false,
        classes: 'table-vertical-align-middle govuk-!-margin-top-6',
        head: [
          {
            text: "Name"
          },
          {
            text: "Prison number"
          },
          {
            text: 'Location'
          },
          {
            text: "Action"
          }
        ],
        rows: rows
      }) }}
    {% endif %}
    </div>
    <div class="govuk-grid-column-one-third">
      <div class="moj-interruption-card">
        <div class="moj-interruption-card__content">
          <h1 class="moj-interruption-card__heading govuk-!-font-size-27">Bulk transfer list</h1>
          <div class="moj-interruption-card__body">
            {% if transfers.length %}
              {% for transfer in transfers %}
                <div class="govuk-grid-row govuk-!-font-size-19 govuk-!-static-margin-bottom-1">
                  <div class="govuk-grid-column-three-quarters">
                    {{ transfer.prisoner | lastNameCommaFirstName }}
                  </div>
                  <div class="govuk-grid-column-one-quarter">
                    <a class="govuk-link govuk-link--inverse" href="search-prisoners/{{ transfer.prisoner.prisonerNumber }}/remove">Remove</a>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <p>Prisoners in this list will share the same transfer details.</p>
            {% endif %}
          </div>
          <form method="POST" action="search-prisoners/continue">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            {{ govukButton({
              classes: "govuk-button--inverse govuk-!-static-margin-bottom-0",
              text: "Continue",
              preventDoubleClick: true,
              disabled: not transfers.length
            }) }}
          </form>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
