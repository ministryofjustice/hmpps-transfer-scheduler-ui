{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set pageTitle = 'Check your edits - Edit scheduled transfers in bulk' %}

{% block innerContent %}
  <div class="govuk-width-container">
    <span class="govuk-caption-l">Edit scheduled transfers in bulk</span>
    <h1 class="govuk-heading-l govuk-!-margin-bottom-7">Check your edits</h1>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-m">Bulk transfer list details</h2>
      </div>
      <div class="govuk-grid-column-one-third">
        <a class="govuk-link govuk-link--no-visited-state float-right" href="edit-list">Change<span class="govuk-visually-hidden"> bulk transfer list details</span></a>
      </div>
    </div>

    {{ govukSummaryList({
      classes: "govuk-!-margin-bottom-7",
      rows: [
        {
          key: { text: "Date" },
          value: { text: startDate | formatDate("d MMMM yyyy") } if startDate else { text: 'No change', classes: 'govuk-hint' }
        },
        {
          key: { text: "Time" },
          value: { text: startTime } if startDate else { text: 'No change', classes: 'govuk-hint' }
        },
        {
          key: { text: "Destination" },
          value: { text: destination.description  } if destination else { text: 'No change', classes: 'govuk-hint' }
        },
        {
          key: { text: "Escort details" },
          value: { text: logistics.description  } if logistics else { text: 'No change', classes: 'govuk-hint' }
        }
      ]
    }) }}

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-m">Prisoners in this bulk transfer</h2>
      </div>
      <div class="govuk-grid-column-one-third">
        <a class="govuk-link govuk-link--no-visited-state float-right" href="edit-list#selectedTransfers-1">Change<span class="govuk-visually-hidden"> prisoners in this bulk transfer</span></a>
      </div>
    </div>

    {% set prisoners = [] %}
    {% for transfer in transfers %}
      {% set prisoners = (prisoners.push({ key: { text: transfer.prisoner | lastNameCommaFirstName }, value: { text: '' } }), prisoners) %}
    {% endfor %}

    {{ govukSummaryList({
      classes: "govuk-!-margin-bottom-7",
      rows: prisoners
    }) }}

    {% for transfer in transfers %}
      <h2 class="govuk-heading-m">{{ transfer.prisoner | lastNameCommaFirstName }}</h2>

      {{ govukSummaryList({
        classes: "govuk-!-margin-bottom-7",
        rows: [
          {
            key: { text: "Reason" },
            value: { text: transfer.reason.description  },
            actions: {
            items: [
              {
                href: "change-details/" + transfer.prisoner.identifier + "#reason",
                text: "Change",
                visuallyHiddenText: "reason for " + transfer.prisoner | firstNameSpaceLastName,
                classes: "govuk-link--no-visited-state"
              }
            ]
          }
          },
          {
            key: { text: "Comments" },
            value: { text: (transfer.comments or 'Not provided') | escape | nl2br },
            actions: {
            items: [
              {
                href: "change-details/" + transfer.prisoner.identifier + "#comments",
                text: "Change",
                visuallyHiddenText: "comments for " + transfer.prisoner | firstNameSpaceLastName,
                classes: "govuk-link--no-visited-state"
              }
            ]
          }
          }
        ]
      }) }}
    {% endfor %}

    <form method="post">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      {{ govukButton({
        text: "Confirm edits",
        preventDoubleClick: true
      }) }}
    </form>
  </div>
{% endblock %}
