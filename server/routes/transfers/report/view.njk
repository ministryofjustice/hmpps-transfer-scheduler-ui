{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set fullWidth = true %}
{% set pageTitle = 'Transfer report - Manage scheduled transfers' %}

{% block innerContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Manage scheduled transfers</span>
      <h1 class="govuk-heading-l">Transfer report</h1>
    </div>
  </div>

  <div class="govuk-!-display-none-print">
    {% if shareLink %}
      <p>Copy the link to share with the receiving prison. This link will expire in 7 days.</p>
      <p class="share-link">
        <span id="copy-alert" class="govuk-visually-hidden" aria-live="polite"></span>
        <span id="share-link">{{ ingressUrl }}/share-report/{{ shareLink }}</span>
        <button class="govuk-button govuk-button--secondary copy-button" id="copy-share-link">Copy</button>
      </p>
    {% else %}
      <p>
        Create a report link to share. This link will expire in 7 days.
      </p>
      <form method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        {{ govukButton({
          text: "Create report link",
          preventDoubleClick: true
        }) }}
      </form>
    {% endif %}
  </div>

  {% include 'transfers/report/partials/transfer-report.njk' %}
{% endblock %}
